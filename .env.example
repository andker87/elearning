# Copia questo file in .env e valorizza con segreti reali (mai committare .env).
POSTGRES_DB=elearning
POSTGRES_USER=elearning
POSTGRES_PASSWORD=change-me

# Genera con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Integrazione Microsoft Graph (Teams attendance) - opzionale, da valorizzare quando
# l'admin M365 concede il consenso per l'app registration. Se vuoti, resta attivo
# solo il fallback manuale (incolla link riunione / carica report).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# SMTP per l'invio di notifiche via email - si configura solo qui (mai da UI):
# chi amministra la piattaforma vede solo lo stato (configurato/host/mittente),
# non le credenziali. Se vuoto, l'invio email resta disattivato (no-op).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_MITTENTE=
SMTP_TLS=true

# Single sign-on aziendale (OpenID Connect) - si configura solo qui (mai da UI).
# Se vuoto, il login resta solo email+password. Registrare nell'IdP un'app
# "web" con redirect URI  <SSO_PUBLIC_URL>/api/auth/sso/callback
# Microsoft Entra: SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SSO_PROVISIONA_UTENTI=true crea al primo accesso chi non esiste ancora
# (ruolo "user"); false (default) ammette solo utenti gia' presenti.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_PUBLIC_URL=
SSO_LABEL=Accedi con l'account aziendale
SSO_PROVISIONA_UTENTI=false

# Sincronizzazione utenti da Microsoft Entra ID (onboarding/offboarding) - solo qui.
# Usa le credenziali GRAPH_* sopra; l'app registration deve avere i permessi
# applicativi User.Read.All e GroupMember.Read.All con consenso dell'amministratore.
# ENTRA_SYNC_GRUPPO_ID = object id del gruppo Entra che elenca chi usa la piattaforma:
# chi esce dal gruppo (o ha l'account disabilitato) viene disattivato, chi entra viene
# creato. Se vuoto la funzione e' spenta. Dalla pagina "Sincronizzazione utenti" si vede
# sempre un'anteprima prima di applicare. ENTRA_SYNC_AUTO=true esegue il giro ogni
# notte alle 02:30, con un freno se le disattivazioni sono troppe (in quel caso avvisa).
ENTRA_SYNC_GRUPPO_ID=
ENTRA_SYNC_AUTO=false

# Proxy o bilanciatori davanti alla piattaforma (reti o indirizzi separati da virgola, es.
# "10.0.0.0/8,192.168.1.5"). Solo da questi la piattaforma crede agli header che indicano l'IP
# del client (X-Forwarded-For, CF-Connecting-IP): senza, nell'audit e nei limiti di tentativi
# compare l'indirizzo di chi si connette (il proxy stesso) e nessun header puo' essere
# falsificato. Va indicato l'indirizzo con cui il proxy aziendale arriva alla piattaforma.
PROXY_FIDUCIARI=
# true solo se davanti alla piattaforma c'e' Cloudflare (tunnel o proxy): l'IP del client si legge
# da CF-Connecting-IP. Con un proxy aziendale lasciare false: si usa la catena X-Forwarded-For.
PROXY_CLOUDFLARE=false

# --- CORS (facoltativo) ---
# Di norma NON serve: sito e API stanno sullo stesso indirizzo. Se un altro sito deve chiamare le API,
# elencalo qui (separati da virgola, mai "*"). Vuoto = nessun altro sito ammesso.
CORS_ORIGINS=

# --- Registro attivita' (audit) ---
# Quanti mesi si conservano gli eventi (0 = per sempre). Ogni notte quelli piu' vecchi vengono cancellati.
AUDIT_RETENZIONE_MESI=24
# Facoltativo: esportazione giornaliera dei log (un file .ndjson per giorno, una riga JSON per evento),
# da far prelevare a un sistema di gestione dei log. Con il valore /app/audit-export i file finiscono nel
# volume "audit_export". Se impostata, la pulizia cancella solo giorni gia' esportati.
AUDIT_EXPORT_DIR=
# Facoltativo: ogni evento viene anche scritto, in tempo reale, sull'output del container come riga "AUDIT {json}"
# (raccoglibile dal logging di Docker). true/false.
AUDIT_LOG_STDOUT=false

# --- Cifratura dei file e dei segreti (vedi docs/sicurezza.md) ---
# Chiave: python -m app.cifratura_cli genera-chiave. CONSERVALA in due luoghi sicuri, separati dai backup:
# se si perde, i dati cifrati non sono recuperabili.
CHIAVE_CIFRATURA=
# Solo durante un cambio di chiave: le chiavi vecchie, separate da virgola.
CHIAVI_CIFRATURA_PRECEDENTI=
# true (consigliato in produzione): senza chiave la piattaforma non si avvia.
CIFRATURA_OBBLIGATORIA=false

# --- Video ---
# Qualita' (altezza in pixel) in cui convertire i video caricati, fino a quella del file originale (mai ingrandito).
# Meno qualita' = meno tempo di conversione e meno spazio. 2160 = 4K.
VIDEO_ALTEZZE=480,720,1080,2160
